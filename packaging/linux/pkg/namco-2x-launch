#!/bin/sh
# Installed-package launcher for the Namco System 2x decompilations (System 22 / Super 22; Cyber Sled is System 21, Time Crisis 2 System 23).
#   namco-2x-launch prop [0-3] [args]     Prop Cycle (a number = straight to that level)
#   namco-2x-launch rave [1-9] [args]     Rave Racer (a number = window scale)
#   namco-2x-launch tokyo [1-9] [args]    Tokyo Wars (a number = window scale)
#   namco-2x-launch dirt [1-9] [args]     Dirt Dash (a number = window scale)
#   namco-2x-launch tc [1-9] [args]       Time Crisis (a number = window scale; the mouse is the gun)
#   namco-2x-launch ace [1-9] [args]      Ace Driver (a number = window scale)
#   namco-2x-launch cc [1-9] [args]       Cyber Commando (a number = window scale)
#   namco-2x-launch cs [1-9] [args]       Cyber Sled (a number = window scale)
#   namco-2x-launch tc2 [1-9] [args]      Time Crisis 2 (a number = window scale; the mouse is the gun)
# Each game plays from its own folder under ~/.local/share/namco-2x-systems/ (or the older
# ~/.local/share/namco22/ when that exists, so 0.6 settings and scores carry over), which holds
# its roms/, the unpacked chips, the settings, scores and recordings. The ROM zips
# (MAME sets) go in that roms/ folder; ~/Downloads is checked on first start.
# AppImage: zips next to the .AppImage (or in a roms/ folder beside it) are found too,
# and PORTABLE MODE -- a folder named namco-2x-systems-data (or the older namco22-data) next to the .AppImage, or the AppImage standard's
# <name>.AppImage.home -- keeps everything there instead of ~/.local/share (one disk for a Steam Deck and a PC).
LIB=${NAMCO2X_LIB:-${NAMCO22_LIB:-/usr/lib/namco-2x-systems}}      # an AppImage points this at its own copy
game="$1"; [ $# -gt 0 ] && shift
extra=""                                    # optional companion zips, copied when present (never "missing")
case "$game" in
    prop|propcycle) title="Prop Cycle"; dir=propcycle; zips="propcycl.zip" ;;
    rave|raverace)  title="Rave Racer"; dir=raverace;  zips="raverace.zip namcoc74.zip" ;;
    tokyo|tokyowar|tokyowars|tw) title="Tokyo Wars"; dir=tokyowar; zips="tokyowar.zip" ;;
    dirt|dirtdash|dd) title="Dirt Dash"; dir=dirtdash; zips="dirtdash.zip"; extra="dirtdasha.zip" ;;   # a SPLIT MAME set keeps the
                                                    # DT2 Ver.A program chips (dt2vera.1/.2) in dirtdasha.zip (GitHub #8)
    tc|timecris|timecrisis|crisis) title="Time Crisis"; dir=timecris; zips="timecris.zip" ;;
    ace|acedriver|ad) title="Ace Driver"; dir=acedriver; zips="acedrive.zip namcoc74.zip" ;;
    cc|cybrcomm|cybercommando|commando) title="Cyber Commando"; dir=cybrcomm; zips="cybrcomm.zip namcoc74.zip" ;;
    cs|cybsled|cybersled|sled) title="Cyber Sled"; dir=cybsled; zips="cybsled.zip namcoc67.zip namcoc68.zip" ;;
    tc2|timecrs2|timecrisis2|crisis2) title="Time Crisis 2"; dir=tc2; zips="timecrs2.zip"; extra="namco_tssio.zip" ;;
    *) sed -n '2,17p' "$0" | sed 's/^# \?//'; exit 1 ;;
esac
# $APPIMAGE is the .AppImage's own path (set by the AppImage runtime, also with --appimage-extract-and-run)
appdir=""; [ -n "${APPIMAGE:-}" ] && appdir=$(dirname "$APPIMAGE")
# the folders are named namco-2x-systems since 0.7; one named namco22 (0.6 and before) is used when it is there, so nothing is lost
pdir=""; [ -n "$appdir" ] && for p in "$appdir/namco-2x-systems-data" "$appdir/namco22-data"; do [ -d "$p" ] && { pdir=$p; break; }; done
if [ -n "$pdir" ]; then
    data="$pdir/$dir"                                  # portable: the folder travels with the AppImage
    echo "[launch] portable mode: $data" >&2
elif [ -n "${APPIMAGE:-}" ] && { [ -d "$APPIMAGE.home" ] || [ -d "${APPIMAGE%.AppImage}.home" ]; }; then
    # the AppImage standard's portable folder, GitHub #23: <name>.AppImage.home (or <name>.home, as users name it). The
    # runtime moves $HOME into it, but the user who tried it still found the data under ~/.local/share (an
    # $XDG_DATA_HOME in the environment, or a runtime without the feature), so the launcher looks for it itself.
    h="$APPIMAGE.home"; [ -d "$h" ] || h="${APPIMAGE%.AppImage}.home"
    data="$h/namco-2x-systems/$dir"; [ ! -d "$data" ] && [ -d "$h/namco22/$dir" ] && data="$h/namco22/$dir"
    echo "[launch] portable mode: $data" >&2
else
    share="${XDG_DATA_HOME:-$HOME/.local/share}"
    data="$share/namco-2x-systems/$dir"
    if [ ! -d "$data" ]; then
        if [ -d "$share/namco22/$dir" ]; then data="$share/namco22/$dir"
        elif [ "$dir" = tc2 ] && [ -d "$share/tc2" ]; then data="$share/tc2"     # Time Crisis 2's own AppImage (0.1.0-rc1) kept it here
        fi
    fi
fi
mkdir -p "$data/roms" || exit 1
cd "$data" || exit 1

hidden=" ~/.local is hidden: press Ctrl+H in a file manager."
case "$data" in "${XDG_DATA_HOME:-$HOME/.local/share}"/*) ;; *) hidden="" ;; esac
missing=""
for z in $zips; do
    [ -f "roms/$z" ] && continue
    for s in ${appdir:+"$appdir/$z" "$appdir/roms/$z"} "$HOME/Downloads/$z" "$HOME/$z"; do
        if [ -f "$s" ]; then cp "$s" roms/ && break; fi
    done
    [ -f "roms/$z" ] || missing="$missing $z"
done
for z in $extra; do
    [ -f "roms/$z" ] && continue
    for s in ${appdir:+"$appdir/$z" "$appdir/roms/$z"} "$HOME/Downloads/$z" "$HOME/$z"; do
        if [ -f "$s" ]; then cp "$s" roms/ && break; fi
    done
done
# Once unpacked the zips are no longer needed, so only complain before that.
if [ -n "$missing" ] && [ -z "$(ls -A extracted 2>/dev/null)" ]; then
    msg="$title needs its ROM files (no game data is included).

Missing:$missing

Copy the MAME ROM zip(s) into this folder, then start the game again:
    $data/roms${appdir:+
(or next to the AppImage: $appdir)}

(This folder is now open.$hidden)"
    echo "$msg" >&2
    if [ -n "$DISPLAY$WAYLAND_DISPLAY" ]; then
        if command -v zenity >/dev/null 2>&1; then zenity --error --title="$title" --text="$msg" 2>/dev/null
        elif command -v kdialog >/dev/null 2>&1; then kdialog --title "$title" --error "$msg" 2>/dev/null
        elif command -v notify-send >/dev/null 2>&1; then notify-send "$title" "$msg"; fi
        command -v xdg-open >/dev/null 2>&1 && xdg-open "$data/roms" >/dev/null 2>&1 &
    fi
    exit 1
fi

case "$dir" in
    propcycle)
        case "${1:-}" in
            0|1|2|3) c="$1"; shift; exec "$LIB/propcycl" extracted --autostart "$c" "$@" ;;
            *)       PROPCYCL_NO_AUTOSTART=1 exec "$LIB/propcycl" extracted "$@" ;;
        esac ;;
    raverace)
        if [ $# -eq 0 ] || expr "$1" : '[1-9]$' >/dev/null; then
            exec "$LIB/rr" extracted --window ${1:+"$1"}
        fi
        exec "$LIB/rr" extracted "$@" ;;
    tokyowar)
        if [ $# -eq 0 ] || expr "$1" : '[1-9]$' >/dev/null; then
            exec "$LIB/tw" extracted --window ${1:+"$1"}
        fi
        exec "$LIB/tw" extracted "$@" ;;
    dirtdash)
        if [ $# -eq 0 ] || expr "$1" : '[1-9]$' >/dev/null; then
            exec "$LIB/dd" extracted --window ${1:+"$1"}
        fi
        exec "$LIB/dd" extracted "$@" ;;
    timecris)
        if [ $# -eq 0 ] || expr "$1" : '[1-9]$' >/dev/null; then
            exec "$LIB/tc" extracted --window ${1:+"$1"}
        fi
        exec "$LIB/tc" extracted "$@" ;;
    acedriver)
        if [ $# -eq 0 ] || expr "$1" : '[1-9]$' >/dev/null; then
            exec "$LIB/ad" extracted --window ${1:+"$1"}
        fi
        exec "$LIB/ad" extracted "$@" ;;
    cybrcomm)
        if [ $# -eq 0 ] || expr "$1" : '[1-9]$' >/dev/null; then
            exec "$LIB/cc" extracted --window ${1:+"$1"}
        fi
        exec "$LIB/cc" extracted "$@" ;;
    cybsled)
        if [ $# -eq 0 ] || expr "$1" : '[1-9]$' >/dev/null; then
            exec "$LIB/cs21" extracted --window ${1:+"$1"}
        fi
        exec "$LIB/cs21" extracted "$@" ;;
    tc2)                                            # finds extracted/ and roms/ itself; it unpacks on first start
        if [ $# -eq 0 ] || expr "$1" : '[1-9]$' >/dev/null || [ "$1" = "--fullscreen" ]; then
            exec "$LIB/tc2" --window "$@" 2>"$data/tc2.log"
        fi
        exec "$LIB/tc2" "$@" ;;
esac
